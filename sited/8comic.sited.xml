    <script>
        <![CDATA[
    function list_parse(url, html) {
        const $ = cheerio.load(html);
        var list = [];
        $('.row a.comicpic_col6').each(function(index) {
            var $$ = cheerio.load($(this).html());
			list.push({
				name: gbk2big5.traditionalized($$('.comicpic_col6_name').text().trim()),
				logo: 'https://www.8comic.com' + $$('img').attr('src'),
				url: "https://www.8comic.com" + $(this).attr('href')
			});
        });
        return JSON.stringify(list);
    }

    function book_parse(url, html) {
        const $ = cheerio.load(html);
        const sections = [];
        $("#rp_tb_comic_0 a.eps_a").each(function(){
            const sectionName = $(this).text().trim();
            const sectionUrl = $(this).attr("onclick").match(/(\d+?)-(\d+?).html/);
            if (sectionName && sectionUrl) {
                sections.push({
                    name: gbk2big5.traditionalizedsectionName),
                    url: "https://articles.onemoreplace.tw/online/new-"+sectionUrl[1]+".html?ch="+sectionUrl[2]
                });
            }
        });
        const book = {
            name: gbk2big5.traditionalized($(".h2").text().trim()),
            logo: 'https://www.8comic.com' + $(".item-cover img").attr("src"),
            sections: sections
        };
        return JSON.stringify(book);
    }
	
    function section_parse(url, html) {
        const $ = cheerio.load(html);
		if (!imageList || imageList.length === 0) {
			const emptyData = [];
			return JSON.stringify({
				type: "article",
				data: emptyData
			});
		}

		const data = imageList.map(fullImageUrl => {
			const src = fullImageUrl.startsWith('http:') ? 'https' + fullImageUrl.substring(4) : fullImageUrl;
			return {
				t: "image",
				d: src
			};
		});
		return JSON.stringify({
			type: "article",
			data: data
		});
	}
    ]]>
