            <item title="H4610" url="https://123av.com/zh/tags/h4610?page=@page"/>
        </tags>
    </home>

    <search cache="10m" method="get" parse="list_parse" url="https://123av.com/zh/search?keyword=@key&amp;page=@page"/>
    <tag>
        <tag cache="10m" showImg="1" w="5" h="7" method="get" parse="list_parse" expr="\/(dm9|tags|actresses|makers|series)\/"/>
        <tag cache="10m" showImg="1" w="5" h="7" method="get" parse="list_parse" expr="\/search"/>
    </tag>
    
    <book cache="10m" method="get" parseUrl="book_get_api_url" parse="book_parse_api_response"/>
    <section cache="0" method="get" parse="section_parse"/>

</main>

<script>
    <require>
        <item url="https://sakl2012.github.io/sited/cheerio.js" lib="cheerio" />
        <item url="https://cdn.jsdelivr.net/npm/chinese-conv@3.2.2/dist/index.js" lib="chineseConv" />
    </require>
    <code>
    <![CDATA[
    function uu(u){
        if (!u) return "";
        u = u.replace(/^\/\//,'https://');
        return encodeURI(u.match(/^http/) ? u : 'https://123av.com' + u.replace(/^\.\/|^\//,'/'));
    }

    function list_parse(url, html){	
        var $ = cheerio.load(html);
        var list = [];
        $('.box-item-list .box-item').each(function(i, e) {
            var self = $(this);
            list.push({
                name: chineseConv.s2t(self.find('.detail a').text().trim()),
                url: uu(self.find('.thumb a').attr('href')),
                logo: self.find('.thumb img').attr('data-src') || self.find('.thumb img').attr('src')
            });
        });
        return JSON.stringify(list);
    }
    
    function book_get_api_url(url, html) {
        var match = html.match(/Movie\({id: (\d+),/);
        if (match) {
            var movieId = match[1];
            return 'https://123av.com/ajax/movie/sources/' + movieId;
        }
        return null;
    }

    function book_parse_api_response(url, jsonString) {
        var data = JSON.parse(jsonString);
        if (!data || !data.watch || data.watch.length === 0) {
            return null;
        }
        var book = {
            name: chineseConv.s2t(data.title),
            logo: data.cover,
            sections: []
        };
        data.watch.forEach(function(item) {
            book.sections.push({
                name: chineseConv.s2t("部分 " + item.name),
                url: item.url
            });
        });
        return JSON.stringify(book);
    }

    function section_parse(url, html) {
        return url;
    }
    ]]>
    </code>
</script>
</sited>