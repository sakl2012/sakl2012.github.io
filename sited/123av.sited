<?xml version="1.0" encoding="utf-8"?>
<sited ver="1" debug="1" engine="34" schema="1">
<meta>
    <title>123AV (繁體化)</title>
    <intro>最佳日本AV成人網站，永久免費JAV (自動簡轉繁)</intro>
    <author>sakl2012</author>
    <url>https://123av.com/</url>
    <expr>123av\.(com|ws|to)</expr>
    <encode>utf-8</encode>
</meta>

<main dtype="3" durl="https://123av.com/zh/">
    <home>
        <tags title="123AV 全部分類">
            <item group="觀看JAV" title="審查" url="https://123av.com/zh/dm9/censored?page=@page"/>
            <item title="最近更新" url="https://123av.com/zh/dm9/recent-update?page=@page"/>
            <item title="新發佈" url="https://123av.com/zh/dm9/new-release?page=@page"/>
            <item title="未審查" url="https://123av.com/zh/dm9/uncensored?page=@page"/>
            <item title="洩露未審查" url="https://123av.com/zh/dm9/uncensored-leaked?page=@page"/>
            <item title="VR" url="https://123av.com/zh/dm9/vr?page=@page"/>
            <item title="熱門女演員" url="https://123av.com/zh/actresses?sort=most_viewed_today&amp;page=@page"/>
            <item title="熱門" url="https://123av.com/zh/dm9/trending?page=@page"/>
            <item title="今天最多觀看" url="https://123av.com/zh/dm9/today-hot?page=@page"/>
            <item title="本週最多觀看" url="https://123av.com/zh/dm9/weekly-hot?page=@page"/>
            <item title="本月最多觀看" url="https://123av.com/zh/dm9/monthly-hot?page=@page"/>
            
            <item group="列表" title="類型" url="https://123av.com/zh/genres?page=@page"/>
            <item title="製作人" url="https://123av.com/zh/makers?page=@page"/>
            <item title="女演員" url="https://123av.com/zh/actresses?page=@page"/>
            <item title="系列" url="https://123av.com/zh/series?page=@page"/>

            <item group="業餘" title="SIRO" url="https://123av.com/zh/tags/siro?page=@page"/>
            <item title="LUXU" url="https://123av.com/zh/tags/259luxu?page=@page"/>
            <item title="200GANA" url="https://123av.com/zh/tags/200gana?page=@page"/>
            <item title="PRESTIGE PREMIUM" url="https://123av.com/zh/tags/prestige-premium?page=@page"/>
            <item title="ORECO" url="https://123av.com/zh/tags/230oreco?page=@page"/>
            <item title="S-CUTE" url="https://123av.com/zh/tags/s-cute?page=@page"/>
            <item title="ARA" url="https://123av.com/zh/tags/261ara?page=@page"/>
