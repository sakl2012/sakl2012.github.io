            <item title="328HMDN" url="https://123av.com/zh/tags/328hmdn?page=@page"/>

            <item group="未審查" title="洩露未審查" url="https://123av.com/zh/dm9/uncensored-leaked?page=@page"/>
            <item title="FC2" url="https://123av.com/zh/tags/fc2?page=@page"/>
            <item title="HEYZO" url="https://123av.com/zh/tags/heyzo?page=@page"/>
            <item title="Tokyo-Hot" url="https://123av.com/zh/tags/tokyo-hot?page=@page"/>
            <item title="1pondo" url="https://123av.com/zh/tags/1pondo?page=@page"/>
            <item title="Caribbeancom" url="https://123av.com/zh/tags/caribbeancom?page=@page"/>
            <item title="Caribbeancompr" url="https://123av.com/zh/tags/caribbeancompr?page=@page"/>
            <item title="10musume" url="https://123av.com/zh/tags/10musume?page=@page"/>
            <item title="pacopacomama" url="https://123av.com/zh/tags/pacopacomama?page=@page"/>
            <item title="Gachinco" url="https://123av.com/zh/tags/gachig?page=@page"/>
            <item title="XXX-AV" url="https://123av.com/zh/tags/xxx-av?page=@page"/>
            <item title="C0930" url="https://123av.com/zh/tags/c0930?page=@page"/>
